---
// Animated service illustrations (light UI scenes), one per service.
// Positions are % of the scene; sizes are em, scaled from the scene size.
import '../styles/illo.css';
const { kind } = Astro.props;

const I = {
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  cart: '<circle cx="9" cy="20" r="1.3"/><circle cx="18" cy="20" r="1.3"/><path d="M3 4h2l2.4 11h11l2-8H6.2"/>',
  star: '<path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/>',
  lock: '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  heart: '<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>',
  comment: '<path d="M4 5h16v11H9l-5 4z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  users: '<circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0M16 4a3 3 0 0 1 0 6M21 20a6 6 0 0 0-4-5.6"/>',
  sound: '<path d="M4 9v6h4l5 4V5L8 9z"/><path d="M17 9a4 4 0 0 1 0 6"/>',
  cal: '<rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/>',
  pen: '<path d="M4 20h4L19 9l-4-4L4 16z"/>',
  layers: '<path d="m12 3 9 5-9 5-9-5z"/><path d="m3 13 9 5 9-5"/>',
  code: '<path d="m8 7-5 5 5 5M16 7l5 5-5 5"/>',
  drop: '<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/>',
  target: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/>',
  bars: '<path d="M5 20V11M12 20V5M19 20v-6"/>',
  arrow: '<path d="M7 17 17 7M8 7h9v9"/>',
  doc: '<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4M9 13h6M9 17h6"/>',
  link: '<path d="M10 14a4 4 0 0 0 5.6 0l3-3a4 4 0 0 0-5.6-5.6l-1 1"/><path d="M14 10a4 4 0 0 0-5.6 0l-3 3a4 4 0 0 0 5.6 5.6l1-1"/>',
  zap: '<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>',
  dots: '<circle cx="5" cy="12" r="1.2"/><circle cx="12" cy="12" r="1.2"/><circle cx="19" cy="12" r="1.2"/>',
};
const ic = (n, cls = '') => `<svg class="ic ${cls}" viewBox="0 0 24 24" aria-hidden="true">${I[n]}</svg>`;
const spark = '<svg viewBox="0 0 24 24"><path d="M12 0c.8 6.7 5.3 11.2 12 12-6.7.8-11.2 5.3-12 12-.8-6.7-5.3-11.2-12-12 6.7-.8 11.2-5.3 12-12Z"/></svg>';
const shirt = '<svg class="shirt" viewBox="0 0 100 100"><defs><linearGradient id="sg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7a66ff"/><stop offset="1" stop-color="#3a35a8"/></linearGradient></defs><path d="M36 12 18 20 6 40l14 7 6-9v52h48V38l6 9 14-7-12-20-18-8c-2 6-7 10-14 10s-12-4-14-10z" fill="url(#sg)"/><path d="M50 22v68" stroke="#fff" stroke-opacity=".35" stroke-dasharray="2 4"/></svg>';
const cursor = '<svg class="cursor" viewBox="0 0 24 24"><path d="M5 3l14 8-6 1.5L10 19z" fill="#0a0a0a" stroke="#fff" stroke-width="1.5" stroke-linejoin="round"/></svg>';
const S = (x, y, s = 1, d = 0) => `<i class="spk" style="--x:${x}%;--y:${y}%;--s:${s};--d:${d}s">${spark}</i>`;
const Ring = (n, x, y, size, d = 0, small = false) => `<div class="el ring${small ? ' ring--sm' : ''} pop" style="--x:${x}%;--y:${y}%;--sz:${size}em;--i:${d}"><span class="fl" style="--d:${d * 0.7}s">${ic(n)}</span></div>`;
---
<div class={`ill ill--${kind}`} aria-hidden="true">
  <div class="ill__s">
    <div class="ill__grid"></div>

    {kind === 'ecom' && (
      <Fragment>
        <i class="ln" style="--x:16%;--y:0%;--w:12%;--h:26%;--r:0 0 0 1.2em;border-width:0 0 1px 1px"></i>
        <i class="ln" style="--x:76%;--y:40%;--w:14%;--h:50%;border-width:1px 1px 0 0;--r:0 1.2em 0 0"></i>
        <i class="ln" style="--x:0;--y:52%;--w:100%;--h:0;border-width:1px 0 0 0"></i>
        <i class="ln ln--v" style="--x:89%;--y:0;--h:16%"></i>
        <i class="bar" style="--x:15.5%;--y:41%"></i>
        <Fragment set:html={S(83, 18, 0.9, 0) + S(22, 64, 0.7, 1.2) + S(87, 15, 0.5, 2)} />
        <i class="dot" style="--x:88.5%;--y:16%"></i>
        <Fragment set:html={Ring('search', 14, 31, 4.6, 1) + Ring('star', 24.5, 19.5, 3.6, 2, true) + Ring('lock', 88.5, 58, 3.6, 3, true)} />
        <div class="el ring ring--lg pop" style="--x:87%;--y:27%;--sz:6.6em;--i:2"><span class="fl" style="--d:.4s" set:html={ic('cart')} /></div>

        <div class="el pill pill--lav pop" style="--x:32%;--y:17%;--i:1"><span class="fl" style="--d:.8s"><b class="chk" set:html={ic('check')} />Checkout is live</span></div>

        <div class="el card card--glow pop" style="--x:26.5%;--y:26.5%;--w:50%;--i:0">
          <div class="prod">
            <div class="prod__img"><span class="mono-s tagnew">NEW</span><Fragment set:html={shirt} /></div>
            <div class="prod__body">
              <p class="mono-s muted">STORE / SHIRTS</p>
              <p class="h">Linen Overshirt</p>
              <p class="price">$48.00 <s>$64</s></p>
              <div class="sw"><i class="on" style="--c:#6b5cff"></i><i style="--c:#1d1d22"></i><i style="--c:#e6e3da"></i></div>
              <div class="sz"><i>S</i><i class="on">M</i><i>L</i><i>XL</i></div>
              <span class="btnx btnx--dark clicky"><Fragment set:html={ic('cart')} />Add to cart<Fragment set:html={cursor} /></span>
            </div>
          </div>
        </div>

        <div class="el card pop" style="--x:11.5%;--y:68%;--w:25%;--i:3">
          <div class="fl" style="--d:1.5s">
            <p class="mono-s muted">TODAY’S SALES</p>
            <p class="stat">$2,480 <em class="up">↗ 24%</em></p>
            <svg class="spark" viewBox="0 0 100 24"><path d="M0 20 L14 17 L26 18 L40 13 L54 15 L68 9 L82 11 L100 2" /></svg>
          </div>
        </div>
        <div class="el pill pill--dark pop" style="--x:53%;--y:75.5%;--i:4"><span class="fl" style="--d:2.2s"><span class="mono">Order #1048 · Paid</span><b class="chk chk--lav" set:html={ic('check')} /></span></div>
      </Fragment>
    )}

    {kind === 'social' && (
      <Fragment>
        <i class="ln ln--v" style="--x:82%;--y:0;--h:14%"></i>
        <i class="ln" style="--x:0;--y:50%;--w:100%;--h:0;border-width:1px 0 0 0"></i>
        <i class="ln ln--v" style="--x:17%;--y:76%;--h:24%"></i>
        <i class="bar" style="--x:16.5%;--y:74%"></i>
        <Fragment set:html={S(36, 16, 0.7, 0) + S(65.5, 22, 0.8, 1) + S(84, 22, 0.5, 2)} />
        <Fragment set:html={Ring('heart', 82, 13, 6, 2) + Ring('sound', 30, 80, 3.6, 4, true)} />

        <div class="el card pop" style="--x:11%;--y:21%;--w:18%;--i:2">
          <div class="fl" style="--d:.6s">
            <p class="mono-s muted rowb">CONTENT PLAN <Fragment set:html={ic('cal', 'ic-s')} /></p>
            <div class="plan">{[1,0,2,0,1,2,0,1].map((v) => <i class={`p${v}`}></i>)}</div>
          </div>
        </div>

        <div class="el card card--glow pop" style="--x:36%;--y:15%;--w:29%;--i:0">
          <div class="post">
            <div class="post__head"><span class="av"></span><div><b>yourbrand</b><span class="mono-s muted">SPONSORED · REEL</span></div><Fragment set:html={ic('dots', 'ic-s')} /></div>
            <div class="post__img"><span class="ball"></span><span class="glass"></span><span class="blk"></span></div>
            <div class="post__act"><Fragment set:html={ic('heart', 'ic-s fillv') + ic('comment', 'ic-s') + ic('mail', 'ic-s')} /></div>
            <p class="likes">12,481 likes</p>
            <i class="sk" style="width:80%"></i><i class="sk" style="width:55%"></i>
          </div>
        </div>

        <div class="el card card--dark tilt pop" style="--x:8.5%;--y:51%;--w:25%;--rot:-6deg;--i:3">
          <div class="fl" style="--d:1.2s">
            <p class="mono-s">REACH · 30 DAYS</p>
            <p class="stat stat--xl">128K</p>
            <div class="minibars">{[2,3,2,4,5,7,9].map((h, i) => <i style={`--h:${h};--i:${i}`}></i>)}</div>
          </div>
        </div>

        <div class="el card card--row pop" style="--x:67%;--y:30%;--w:27%;--i:1"><span class="fl" style="--d:.2s"><b class="sq" set:html={ic('users')} /><span><b>+1,284 followers</b><small class="mono-s muted">THIS WEEK</small></span></span></div>
        <div class="el card card--row pop" style="--x:70%;--y:41.5%;--w:27%;--i:2"><span class="fl" style="--d:1.8s"><b class="sq sq--lav" set:html={ic('comment')} /><span><b>86 new comments</b><small class="mono-s muted">TODAY</small></span></span></div>
        <div class="el avs pop" style="--x:70.5%;--y:52%;--i:3"><i style="--c:#f0b48a"></i><i style="--c:#a99cff"></i><i style="--c:#8fc9b0"></i><i style="--c:#1a1a1f"></i><span class="mono-s muted">+2.1K</span></div>
        <div class="el pill pill--lav pop" style="--x:39%;--y:76%;--i:4"><span class="fl" style="--d:2.4s"><b class="chk" set:html={ic('check')} />Post scheduled · 7 PM</span></div>
      </Fragment>
    )}

    {kind === 'web' && (
      <Fragment>
        <i class="ln" style="--x:0;--y:19%;--w:100%;--h:0;border-width:1px 0 0 0"></i>
        <i class="ln ln--v" style="--x:10.5%;--y:55%;--h:45%"></i>
        <i class="ln ln--v" style="--x:47%;--y:84%;--h:16%"></i>
        <i class="ln ln--v" style="--x:93.5%;--y:84%;--h:16%"></i>
        <i class="bar" style="--x:10.5%;--y:42%"></i>
        <i class="dot" style="--x:47%;--y:86%"></i><i class="dot" style="--x:93.5%;--y:83%"></i>
        <Fragment set:html={S(71, 26, 0.6, 0) + S(92, 72, 0.6, 1.4)} />
        <Fragment set:html={Ring('pen', 10.5, 34.5, 4.4, 1) + Ring('layers', 10.5, 50, 3.4, 3, true) + Ring('code', 87.5, 18.5, 6, 2)} />

        <div class="el pill pill--lav pop" style="--x:36%;--y:17%;--i:1"><span class="fl" style="--d:.6s"><b class="chk chk--spark" set:html={spark} />Designed in Figma · built 1:1</span></div>

        <div class="el card card--glow card--flush pop" style="--x:17.5%;--y:24.5%;--w:54%;--i:0">
          <div class="bro">
            <div class="bro__bar"><i></i><i></i><i></i><span class="mono-s">🔒 yourbrand.com</span></div>
            <div class="bro__page">
              <div class="bro__nav"><i class="sq-s"></i><i class="sk-s"></i><i class="sk-s"></i><i class="sk-s"></i><i class="pillb"></i></div>
              <div class="bro__hero">
                <div><p class="h">Fast sites that <span class="lav">actually convert.</span></p><i class="sk" style="width:85%"></i><div class="bro__btns"><i class="b1"></i><i class="b2"></i></div></div>
                <div class="bro__art"><span class="cube"></span></div>
              </div>
              <div class="bro__cards"><i></i><i></i><i></i></div>
            </div>
          </div>
        </div>
        <div class="el card card--glow card--mob pop" style="--x:73%;--y:31%;--w:15%;--i:1">
          <div class="mob"><i class="sk" style="width:40%"></i><span class="mob__img"></span><i class="sk" style="width:90%"></i><i class="mob__btn"></i></div>
        </div>
        <div class="el card card--row pop" style="--x:11%;--y:71.5%;--w:30%;--i:2"><span class="fl" style="--d:1.4s"><b class="score">98</b><span><b>Performance</b><small class="mono-s muted">CORE WEB VITALS · PASS</small></span></span></div>
        <div class="el card card--dark card--code pop" style="--x:49.5%;--y:63%;--w:33%;--i:3">
          <div class="fl" style="--d:2s">
            <div class="code__bar"><i style="--c:#ff5f57"></i><i style="--c:#febc2e"></i><i style="--c:#28c840"></i></div>
            <pre class="mono"><span>1</span>&lt;Hero title=&#123;t&#125; /&gt;
<span>2</span>&lt;Grid cols=&#123;3&#125;&gt;
<span>3</span>  &lt;Card /&gt;
<span>4</span>&lt;/Grid&gt;<b class="caret"></b></pre>
          </div>
        </div>
      </Fragment>
    )}

    {kind === 'brand' && (
      <Fragment>
        <i class="ln" style="--x:0;--y:52%;--w:100%;--h:0;border-width:1px 0 0 0"></i>
        <i class="ln ln--v" style="--x:20%;--y:0;--h:17%"></i>
        <i class="ln ln--v" style="--x:86%;--y:85%;--h:15%"></i>
        <i class="bar" style="--x:18.5%;--y:55%"></i>
        <Fragment set:html={S(26, 17, 0.6, 0) + S(75, 15, 0.7, 1) + S(84, 93, 0.5, 2)} />
        <Fragment set:html={Ring('drop', 86, 46, 3.6, 3, true) + Ring('pen', 13, 81, 6, 4)} />
        <div class="el ring ring--aa pop" style="--x:84.5%;--y:20%;--sz:7.4em;--i:2"><span class="fl" style="--d:.9s"><b>Aa</b><small class="mono-s muted">INTER TIGHT</small></span></div>

        <div class="el card card--glow pop" style="--x:26%;--y:17%;--w:49%;--i:0">
          <div class="logo-card">
            <p class="mono-s muted rowb">PRIMARY LOGO <span>V1.0</span></p>
            <div class="mark"><i></i><i></i></div>
            <p class="wordmark">yourbrand</p>
          </div>
        </div>
        <div class="el card card--dark tilt pop" style="--x:7.5%;--y:27%;--w:19%;--rot:-7deg;--i:1">
          <div class="fl" style="--d:1.4s">
            <p class="mono-s">BRAND BOOK</p>
            <p class="bb">Guidelines<br />2026</p>
            <i class="skd" style="width:85%"></i><i class="skd" style="width:70%"></i><i class="skd" style="width:55%"></i>
            <span class="bbsq"></span>
          </div>
        </div>
        <div class="el swatches pop" style="--x:24%;--y:60%;--i:3">
          {[['#6B5CFF', '#6B5CFF'], ['#393797', '#393797'], ['#0A0A0A', '#0A0A0A'], ['#F5F5F5', '#F5F5F5']].map(([c, l], i) => (
            <div class="swatch fl" style={`--d:${i * 0.4}s`}><i style={`--c:${c}`}></i><span class="mono-s muted">{l}</span></div>
          ))}
        </div>
        <div class="el bcards pop" style="--x:68%;--y:58%;--w:26%;--i:4">
          <div class="fl" style="--d:2.2s"><div class="bc bc--back"><span>yourbrand.com</span></div><div class="bc bc--front"><b>yourbrand</b><i class="sk" style="width:50%"></i><i class="sk" style="width:35%"></i></div></div>
        </div>
        <div class="el pill pill--dark pop" style="--x:31.5%;--y:84%;--i:5"><span class="fl" style="--d:2.6s"><span class="mono">Logo · Colour · Type · Voice</span><b class="chk chk--lav" set:html={ic('layers')} /></span></div>
      </Fragment>
    )}

    {kind === 'ads' && (
      <Fragment>
        <i class="ln" style="--x:0;--y:44%;--w:100%;--h:0;border-width:1px 0 0 0"></i>
        <i class="ln ln--v" style="--x:86.5%;--y:0;--h:12%"></i>
        <i class="ln" style="--x:14%;--y:76%;--w:6%;--h:24%;border-width:1px 0 0 1px;--r:1.2em 0 0 0"></i>
        <i class="bar" style="--x:13.5%;--y:63%"></i>
        <Fragment set:html={S(46, 17, 0.7, 0) + S(93.5, 89, 0.6, 1.2)} />
        <Fragment set:html={Ring('target', 13.5, 50, 4.4, 2) + Ring('sound', 84.5, 17.5, 6, 1) + Ring('bars', 93, 54, 3.4, 3, true)} />

        <div class="el pill pill--lav pop" style="--x:10.5%;--y:15%;--i:1"><span class="fl" style="--d:.3s"><b class="chk" set:html={ic('arrow')} />CTR 3.8%</span></div>
        <div class="el card card--glow pop" style="--x:18.5%;--y:21.5%;--w:28.5%;--i:0">
          <div class="ad">
            <div class="post__head"><span class="av"></span><div><b>yourbrand</b> <span class="mono-s muted">SPONSORED</span></div></div>
            <div class="ad__img"><Fragment set:html={shirt} /></div>
            <p class="ad__off">30% off</p>
            <p class="mono-s muted center">THE LINEN EDIT</p>
            <span class="btnx btnx--dark clicky">Shop now<Fragment set:html={cursor} /></span>
          </div>
        </div>
        <div class="el card card--dark pop" style="--x:53%;--y:24.5%;--w:33%;--i:2">
          <div class="fl" style="--d:1s">
            <p class="mono-s">ROAS · LAST 7 DAYS</p>
            <p class="stat stat--xl">4.2× <em class="up up--lav">↗ 18%</em></p>
            <div class="roas">{[3,4,5,4,6,7,8,11].map((h, i) => <i class={i === 7 ? 'hi' : ''} style={`--h:${h};--i:${i}`}></i>)}</div>
          </div>
        </div>
        <div class="el card pop" style="--x:53%;--y:59%;--w:34%;--i:3">
          <div class="fl" style="--d:1.8s">
            <p class="mono-s muted rowb">AUDIENCE <Fragment set:html={ic('target', 'ic-s lavc')} /></p>
            <div class="chips"><i class="on">Age 22–40</i><i class="on">Worldwide</i><i class="on">Fashion</i><i>Lookalike 2%</i><i>Shoppers</i></div>
          </div>
        </div>
        <div class="el pill pill--dark pop" style="--x:51.5%;--y:81.5%;--i:4"><span class="fl" style="--d:2.4s"><span class="mono">Meta · Google · TikTok</span><b class="chk chk--lav" set:html={ic('zap')} /></span></div>
      </Fragment>
    )}

    {kind === 'seo' && (
      <Fragment>
        <i class="ln" style="--x:0;--y:22%;--w:100%;--h:0;border-width:1px 0 0 0"></i>
        <i class="ln ln--v" style="--x:9.5%;--y:58%;--h:42%"></i>
        <i class="ln ln--v" style="--x:93%;--y:72%;--h:28%"></i>
        <i class="bar" style="--x:9.5%;--y:52%"></i>
        <i class="dot" style="--x:9.5%;--y:80%"></i>
        <Fragment set:html={S(69, 24, 0.7, 0)} />
        <Fragment set:html={Ring('doc', 9.5, 41, 4.4, 2) + Ring('link', 9.5, 61, 3.4, 3, true)} />
        <div class="el ring ring--lg pop" style="--x:87%;--y:15%;--sz:6.2em;--i:1"><span class="fl" style="--d:.5s" set:html={ic('search')} /></div>

        <div class="el kws pop" style="--x:14%;--y:15%;--i:1"><i class="on">linen shirt</i><i>summer outfits</i><i class="on">men’s overshirt</i></div>
        <div class="el card card--glow pop" style="--x:16.5%;--y:28%;--w:51%;--i:0">
          <div class="serp">
            <div class="serp__q"><Fragment set:html={ic('search', 'ic-s')} /><span class="typed">linen overshirt men</span><b class="caret caret--d"></b></div>
            <div class="serp__r on"><span class="rk">#1</span><div><p class="mono-s muted">YOURBRAND.COM › SHOP</p><p class="t lavt">Linen Overshirt — Yourbrand</p><p class="stars">★★★★★ <span class="muted">4.9 · 312 reviews</span></p></div></div>
            <div class="serp__r"><span class="rk rk--g">#2</span><div><p class="mono-s muted">STYLEGUIDE.COM › MEN</p><p class="t">Best linen shirts for summer</p></div></div>
            <div class="serp__r fade"><span class="rk rk--g">#3</span><div><p class="mono-s muted">JOURNAL.COM › FABRICS</p><p class="t">Linen vs cotton: a buyer’s guide</p></div></div>
          </div>
        </div>
        <div class="el card card--dark tilt pop" style="--x:70%;--y:25%;--w:23%;--rot:5deg;--i:2">
          <div class="fl" style="--d:1.1s"><p class="mono-s">GOOGLE RANK</p><p class="stat stat--xxl">#1</p><p class="mono-s lav2">↑ FROM #14</p></div>
        </div>
        <div class="el card pop" style="--x:68.5%;--y:56%;--w:26%;--i:3">
          <div class="fl" style="--d:1.9s">
            <p class="mono-s muted">ORGANIC TRAFFIC</p>
            <p class="stat">+62% <em class="up">↗ 90d</em></p>
            <svg class="spark" viewBox="0 0 100 24"><path d="M0 20 L16 19 L30 16 L44 17 L58 12 L72 13 L86 7 L100 2" /></svg>
