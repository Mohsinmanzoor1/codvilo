---
// Services bento grid. Every card is live HTML with its own animation and
// micro-interactions (see src/scripts/bento.js and src/styles/bento.css).
import '../styles/bento.css';
const dotsBtn = '<span class="bx-dots" aria-hidden="true">' + '<i></i>'.repeat(16) + '</span>';
const I = {
  target: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3.5"/><circle cx="12" cy="12" r=".6"/>',
  eye: '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
  bars: '<path d="M4 20h16M7 17V9M12 17V5M17 17v-6"/>',
  sound: '<path d="M4 9v6h4l5 4V5L8 9z"/><path d="M17 9a4 4 0 0 1 0 6"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  mic: '<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/>',
  heart: '<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  cart: '<circle cx="9" cy="20" r="1.3"/><circle cx="18" cy="20" r="1.3"/><path d="M3 4h2l2.4 11h11l2-8H6.2"/>',
  image: '<rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="1.6"/><path d="m4 17 5-5 4 4 3-3 4 4"/>',
  users: '<circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0M16 4a3 3 0 0 1 0 6M21 20a6 6 0 0 0-4-5.6"/>',
  clock: '<circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/>',
};
const ic = (n) => `<svg class="bx-ic" viewBox="0 0 24 24" aria-hidden="true">${I[n]}</svg>`;
const cursor = '<svg class="bx-cursor" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3l14 8-6 1.5L10 19z" fill="#0a0a0a" stroke="#fff" stroke-width="1.5" stroke-linejoin="round"/></svg>';
---
<section class="bento section light" id="services" data-theme="light">
  <div class="wrap">
    <p class="tag" data-fade><i class="tag__dots"></i>Services</p>
    <h2 class="display bento__title" data-split>Everything your brand needs <span class="tone">to grow.</span></h2>

    <div class="bento__grid" data-bento>
      <!-- 1. Web design & development -->
      <article class="bx bx--dark bx--web" data-bx>
        <div class="bx-web__stage" data-web>
          <div class="bx-web__browser">
            <div class="bx-web__bar"><i style="--c:#ff5f57"></i><i style="--c:#febc2e"></i><i style="--c:#28c840"></i><span></span></div>
            <div class="bx-web__page">
              <div class="bx-web__nav"><i class="logo-sq"></i><span>Home</span><span>Work</span><span>Services</span><span>Contact</span><i class="pillb"></i></div>
              <i class="sk sk--c" style="width:62%"></i><i class="sk sk--c sk--thin" style="width:46%"></i>
              <div class="bx-web__btns"><i class="b1"></i><i class="b2"></i></div>
              <div class="bx-web__blocks"><i></i><i></i></div>
            </div>
          </div>
          <div class="bx-web__phone">
            <div class="bx-web__nav"><i class="logo-sq"></i><i class="pillb"></i></div>
            <i class="sk sk--c" style="width:80%"></i><i class="sk sk--c sk--thin" style="width:60%"></i>
            <div class="bx-web__btns"><i class="b1"></i><i class="b2"></i></div>
            <div class="bx-web__blocks"><i></i></div>
          </div>
        </div>
        <div class="bx__body">
          <h3 class="bx__h"><a class="bx__link" href="/services/website-design/">Web design &amp; development</a></h3>
          <p class="bx__p">Designed in Figma, built pixel for pixel, and handed over so your team can update it without calling us.</p>
          <a class="btn btn--primary bx-cta" href="/work/">View our work <svg class="arr" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg></a>
        </div>
      </article>

      <!-- 2. Social media -->
      <article class="bx bx--social" data-bx>
        <h3 class="bx__h"><a class="bx__link" href="/services/social-media-management/">Social media that shows up every week</a></h3>
        <div class="bx-gauge">
          <svg viewBox="0 0 200 110" aria-hidden="true">
            <defs><linearGradient id="gg" x1="0" x2="1"><stop offset="0" stop-color="#ecebff"/><stop offset="1" stop-color="#f6f6f8"/></linearGradient></defs>
            <path class="g-track" d="M20 100 A80 80 0 0 1 180 100" />
            <path class="g-fill" d="M20 100 A80 80 0 0 1 180 100" pathLength="100" />
            <path class="g-hi" d="M20 100 A80 80 0 0 1 180 100" pathLength="100" />
          </svg>
        </div>
        <div class="bx-notes" data-notes>
          <div class="bx-note is-on"><div><small>Notification</small><b>Reel published · 12.4K views</b></div><span class="bx-badge" set:html={ic('heart')} /></div>
          <div class="bx-note"><div><small>Notification</small><b>+1,284 followers · this week</b></div><span class="bx-badge" set:html={ic('users')} /></div>
          <div class="bx-note"><div><small>Notification</small><b>Post scheduled · Fri 7 PM</b></div><span class="bx-badge" set:html={ic('clock')} /></div>
        </div>
      </article>

      <!-- 3. Paid ads -->
      <article class="bx bx--dark bx--ads" data-bx data-ads>
        <h3 class="bx__h"><a class="bx__link" href="/services/paid-ads/">Paid ads that reach the <span class="tone">right people</span></a></h3>
        <svg class="bx-arcs" viewBox="0 0 448 360" preserveAspectRatio="none" aria-hidden="true">
          <path d="M-10 250 C 120 160, 300 130, 470 170" />
          <path d="M-10 300 C 150 230, 320 260, 470 300" />
          <path d="M150 120 C 200 200, 240 250, 250 300" />
          <path d="M150 120 C 260 100, 340 110, 390 130" />
          <path d="M90 250 C 160 270, 220 290, 250 300" />
        </svg>
        <span class="bx-node" style="--x:34%;--y:33%;--m:1" set:html={ic('target')} />
        <span class="bx-node" style="--x:87%;--y:36%;--m:1.6" set:html={ic('eye')} />
        <span class="bx-node" style="--x:20%;--y:69%;--m:2.2" set:html={ic('bars')} />
        <span class="bx-node bx-node--v" style="--x:56%;--y:83%;--m:0.8" set:html={ic('sound')} />
        <div class="bx-roas" style="--m:1.2">
          <small class="mono-x">ROAS · 30 DAYS</small>
          <b>4.2× <em>↑ 18%</em></b>
        </div>
      </article>

      <!-- 4. SEO -->
      <article class="bx bx--seo" data-bx data-seo>
        <h3 class="bx__h"><a class="bx__link" href="/free-store-audit/">Get found when people search</a></h3>
        <div class="bx-tiles" aria-hidden="true">{Array.from({ length: 12 }).map((_, i) => <i style={`--i:${i}`}></i>)}</div>
        <div class="bx-search"><Fragment set:html={ic('search')} /><span class="bx-q" data-q>linen overshirt men</span><b class="bx-caret"></b><Fragment set:html={ic('mic')} /></div>
        <div class="bx-result" data-result>
          <div class="bx-result__head"><span class="bx-fav"><i></i><i></i></span><div><b>Yourbrand</b><small>yourbrand.com › shop › shirts</small></div><span class="bx-rank">#1</span></div>
          <p>Linen Overshirt — free shipping</p>
          <i class="sk"></i><i class="sk sk--s"></i>
        </div>
      </article>

      <!-- 5. Brand identity -->
      <article class="bx bx--brand" data-bx>
        <h3 class="bx__h"><a class="bx__link" href="/services/branding/">Brand identity and every asset after it</a></h3>
        <svg class="bx-circuit" viewBox="0 0 328 360" preserveAspectRatio="xMaxYMax meet" aria-hidden="true">
          <g class="c-base">
            <path d="M0 160 H60 L100 200 H175" /><path d="M0 180 H50 L90 220 H175" /><path d="M0 200 H40 L80 240 H175" /><path d="M0 220 H30 L70 260 H175" />
            <path d="M262 40 L200 102 V175" /><path d="M300 40 L222 118 V175" /><path d="M328 70 L244 154 V175" /><path d="M328 110 L266 172 V175" />
          </g>
          <g class="c-flow">
            <path d="M0 160 H60 L100 200 H175" /><path d="M0 200 H40 L80 240 H175" />
            <path d="M262 40 L200 102 V175" /><path d="M328 70 L244 154 V175" />
          </g>
        </svg>
        <div class="bx-chip" data-chip><i></i><i></i></div>
      </article>

      <!-- 6. Ecommerce -->
      <article class="bx bx--ecom" data-bx data-ecom>
        <div class="bx-ecom__copy">
          <h3 class="bx__h"><a class="bx__link" href="/services/shopify-development/">Ecommerce stores that convert</a></h3>
          <a class="bx-deal mono" href="/services/shopify-development/#pricing" data-deal-only>Black Friday · Shopify store $499 <s>$799</s></a>
          <p class="bx__p">Shopify and WooCommerce builds, migrations and checkout tuning, fast on every device.</p>
          <div class="bx-chips"><span>Shopify</span><span>WooCommerce</span><span>Headless</span></div>
        </div>
        <div class="bx-shop">
          <div class="bx-shop__bar"><i></i><i></i><i></i><span></span></div>
          <div class="bx-shop__page">
            <div class="bx-shop__img"><span class="bx-shirt"></span><Fragment set:html={ic('image')} /></div>
            <div class="bx-shop__info">
              <b>Linen Overshirt</b><small>$48.00</small>
              <div class="bx-sizes" data-sizes><i>S</i><i class="on">M</i><i>L</i><i>XL</i></div>
              <i class="sk"></i><i class="sk sk--s"></i>
              <span class="bx-add" data-add><Fragment set:html={ic('cart')} />Add to cart<Fragment set:html={cursor} /></span>
            </div>
          </div>
        </div>
        <div class="bx-order" data-order><div><small>Notification</small><b>Order #1048 paid · $48.00</b></div><span class="bx-badge" set:html={ic('check')} /></div>
      </article>

      <!-- 7. Studio -->
      <article class="bx bx--dark bx--studio" data-bx>
        <div class="bx-studio__copy">
          <h3 class="bx__h bx__h--lg">One studio. <span class="tone">Every discipline.</span></h3>
          <p class="bx__p">Strategy, design, development and marketing under one roof: clear quotes, real revision rounds, every file handed over.</p>
          <a class="btn btn--primary bx-cta" href="/contact/">Start a project <svg class="arr" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg></a>
        </div>
        <div class="bx-pixels" data-pixels aria-hidden="true">{Array.from({ length: 24 }).map((_, i) => <i data-p={i}></i>)}</div>
      </article>
    </div>
  </div>
</section>
