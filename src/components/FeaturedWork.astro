---
// Featured work (Stokt-style): cards start stacked as a deck and unfold into a
// full-width list on scroll. Animation lives in src/scripts/featured.js.
import '../styles/featured.css';
const { projects } = Astro.props;
const ARR = '<svg class="arr" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>';
---
<section class="fw section light" id="work" data-theme="light">
  <div class="wrap">
    <div class="fw__head">
      <div>
        <p class="tag" data-fade><i class="tag__dots"></i>Featured work</p>
        <h2 class="display fw__title" data-split>Good things, <span class="tone">built to sell.</span></h2>
      </div>
      <a class="btn btn--primary" href="/work/" data-fade>See all work <Fragment set:html={ARR} /></a>
    </div>

    <div class="fw__deck" data-deck style={`--n:${projects.length}`}>
      {projects.map((p, i) => (
        <a class="fw-card" href={`/work/${p.slug}/`} data-fw-card style={`--i:${i};--theme:${p.theme}`} aria-label={`${p.title}: ${p.subtitle}. View case study`}>
          <div class="fw-card__media">
            <img src={p.cover.src} width={p.cover.w} height={p.cover.h} alt={`${p.title}, ${p.subtitle}`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
          </div>
          <div class="fw-card__meta">
            <h3 class="display">{p.title}</h3>
            <ul>{[p.subtitle, ...p.services.slice(0, 2)].map((t) => <li>{t}</li>)}</ul>
          </div>
          <span class="fw-card__year mono">{p.year}</span>
        </a>
      ))}
    </div>
  </div>
  <div class="fw-cursor" aria-hidden="true" data-fw-cursor><span>View case study</span><Fragment set:html={ARR} /></div>
</section>
