---
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { graph, OG_IMAGE } from '../data/seo.js';
import { dealActive, SHOPIFY_OFFER } from '../data/services.js';

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  home?: boolean;
  jsonld?: object;
  noindex?: boolean;
  ogType?: string;
}
const { title, description, path = '/', image = OG_IMAGE, home = false, jsonld, noindex = false, ogType = 'website' } = Astro.props;
const email = 'hello.codvilo@gmail.com';
const p = home ? '' : '/';
const nav = [
  { label: 'Work', href: home ? '#work' : '/work/' },
  { label: 'Services', href: '/services/' },
  { label: 'Process', href: `${p}#process` },
  { label: 'Platforms', href: `${p}#platforms` },
  { label: 'About', href: `${p}#about` },
];
const footerServices = [['Shopify stores', '/services/shopify-development/'], ['WooCommerce stores', '/services/woocommerce-development/'], ['Website design', '/services/website-design/'], ['Social media', '/services/social-media-management/'], ['Brand identity', '/services/branding/'], ['Paid advertising', '/services/paid-ads/'], ['Free store audit', '/free-store-audit/']];
const url = `https://codvilo.com${path}`;
---

<!doctype html>
<html lang="en" class={dealActive() ? 'deal-live' : 'deal-over'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0A0A0A" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="author" content="Mohsin Manzoor" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-friendly summary of Codvilo" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta property="og:site_name" content="Codvilo" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="preconnect" href="https://mir-s3-cdn-cf.behance.net" crossorigin />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonld ?? graph())} />}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script is:inline define:vars={{ dealEnds: SHOPIFY_OFFER.deal.endsAt }}>
      if (Date.now() > new Date(dealEnds).getTime()) { document.documentElement.classList.remove('deal-live'); document.documentElement.classList.add('deal-over'); }
    </script>
  </head>
  <body>
    <header class="nav" data-nav>
      <a class="nav__logo" href={home ? '#top' : '/'} aria-label="Codvilo home"><Logo /></a>
      <nav class="nav__pill" aria-label="Primary">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <a class="btn btn--primary nav__cta" href="/contact/">Start a project <svg class="arr" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg></a>
      <button class="burger" aria-label="Open menu" aria-expanded="false" data-burger><span></span><span></span></button>
    </header>

    <div class="menu" data-menu aria-hidden="true">
      <nav aria-label="Mobile">
        {[...nav, { label: 'Contact', href: '/contact/' }].map((n, i) => (
          <a href={n.href} data-menu-link><small>0{i + 1}</small><span>{n.label}</span></a>
        ))}
      </nav>
      <a class="menu__mail" href={`mailto:${email}`}>{email}</a>
    </div>

    {dealActive() && !Astro.url.pathname.startsWith('/services/shopify') && (
      <aside class="deal-pill" data-deal-banner data-ends={SHOPIFY_OFFER.deal.endsAt} aria-label="Black Friday offer">
        <a href="/services/shopify-development/#pricing" class="deal-pill__link">
          <span class="deal-pill__tag mono">{SHOPIFY_OFFER.deal.label}</span>
          <span class="deal-pill__text">Complete Shopify store <b>${SHOPIFY_OFFER.deal.price}</b> <s>${SHOPIFY_OFFER.regularPrice}</s></span>
          <span class="deal-pill__time mono">Ends in <b data-countdown>soon</b></span>
        </a>
        <button class="deal-pill__x" type="button" aria-label="Dismiss offer" data-deal-close>×</button>
      </aside>
    )}
    <main id="top">
      <slot />
    </main>

    <footer class="footer dark" data-theme="dark">
      <div class="wrap footer__grid">
        <div class="footer__brand">
          <a href={home ? '#top' : '/'} aria-label="Codvilo home"><Logo /></a>
          <p>Ecommerce, social media and web for ambitious brands.</p>
          <a class="footer__mail" href={`mailto:${email}`}>{email}</a>
        </div>
        <div class="footer__col">
          <p class="mono">Index</p>
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        </div>
        <div class="footer__col">
          <p class="mono">Services</p>
          {footerServices.map(([s, h]) => <a href={h}>{s}</a>)}
        </div>
        <div class="footer__col">
          <p class="mono">Contact</p>
          <a href="/contact/">Contact form</a>
          <a href={`mailto:${email}`}>Email us</a>
          <a href="https://www.behance.net/Mohammad-Mohsin" target="_blank" rel="noopener">Behance ↗</a>
          <a href="#top">Back to top ↑</a>
        </div>
      </div>
      <div class="wrap footer__bottom">
        <span>© {new Date().getFullYear()} Codvilo. All rights reserved.</span>
        <span>Founded by Mohsin Manzoor</span>
      </div>
    </footer>
  </body>
</html>
