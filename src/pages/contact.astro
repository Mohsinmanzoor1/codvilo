---
import Base from '../layouts/Base.astro';
import '../styles/contact.css';

const email = 'hello.codvilo@gmail.com';
const services = ['Ecommerce store', 'Social media', 'Web design & development', 'Brand identity', 'Paid advertising', 'SEO & content'];
const budgets = ['Under $1k', '$1k–3k', '$3k–10k', '$10k+', 'Not sure yet'];
const timelines = ['As soon as possible', 'Within 1–3 months', 'Flexible'];
const steps = [
  { t: 'We read your brief', d: 'Every message goes straight to Mohsin’s inbox and gets a personal reply.' },
  { t: 'A short intro call', d: 'We talk through your goals, timeline and what success looks like.' },
  { t: 'A clear proposal', d: 'Scope, timeline and price in plain language, before any work starts.' },
];
const check = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>';
---
<Base title="Contact — Codvilo" description="Tell us about your project. Ecommerce, social media, brand and web: one team, from idea to launch." path="/contact/">
  <section class="ct dark" data-theme="dark">
    <div class="ct__glow" aria-hidden="true"></div>
    <div class="wrap">
      <header class="ct__head">
        <p class="tag tag--dark" data-fade><i class="tag__dots"></i>Contact</p>
        <h1 class="display ct__title" data-split>Let’s build something <span class="tone">that sells.</span></h1>
        <p class="ct__lede" data-fade>Tell us a little about your brand and what you need. Mohsin will get back to you personally.</p>
      </header>

      <div class="ct__grid">
        <!-- Form -->
        <div class="ct-card ct-form-card" data-fade>
          <form class="ct-form" data-form novalidate>
            <div class="ct-row">
              <label class="fld">
                <input name="name" type="text" autocomplete="name" placeholder=" " required maxlength="100" />
                <span>Your name *</span>
                <em class="fld__err" data-err="name"></em>
              </label>
              <label class="fld">
                <input name="email" type="email" autocomplete="email" placeholder=" " required maxlength="160" />
                <span>Email address *</span>
                <em class="fld__err" data-err="email"></em>
              </label>
            </div>
            <label class="fld">
              <input name="company" type="text" autocomplete="organization" placeholder=" " maxlength="120" />
              <span>Company or brand</span>
            </label>

            <fieldset class="ct-set">
              <legend>What do you need? <small>Pick all that apply</small></legend>
              <div class="chips" data-chips="services">
                {services.map((s) => <button type="button" class="chip" data-value={s} aria-pressed="false"><i set:html={check} />{s}</button>)}
              </div>
            </fieldset>

            <div class="ct-row">
              <fieldset class="ct-set">
                <legend>Budget</legend>
                <div class="chips" data-chips="budget" data-single>
                  {budgets.map((s) => <button type="button" class="chip" data-value={s} aria-pressed="false"><i set:html={check} />{s}</button>)}
                </div>
              </fieldset>
            </div>
            <fieldset class="ct-set">
              <legend>Timeline</legend>
              <div class="chips" data-chips="timeline" data-single>
                {timelines.map((s) => <button type="button" class="chip" data-value={s} aria-pressed="false"><i set:html={check} />{s}</button>)}
              </div>
            </fieldset>

            <label class="fld fld--area">
              <textarea name="message" rows="5" placeholder=" " required maxlength="5000" data-msg></textarea>
              <span>Tell us about your project *</span>
              <b class="fld__count" data-count>0 / 5000</b>
              <em class="fld__err" data-err="message"></em>
            </label>

            <!-- Spam trap: hidden from people, filled by bots -->
            <label class="hp" aria-hidden="true">Website <input name="website" type="text" tabindex="-1" autocomplete="off" /></label>

            <div class="ct-submit">
              <button class="ct-send" type="submit" data-send>
                <span class="ct-send__dots" aria-hidden="true">{Array.from({ length: 16 }).map(() => <i></i>)}</span>
                <span class="ct-send__label">Send message</span>
                <span class="ct-send__spin" aria-hidden="true"></span>
              </button>
              <p class="ct-note">By sending, you agree we can reply to you by email. No spam, ever.</p>
            </div>
            <p class="ct-alert" role="alert" data-alert hidden></p>
          </form>

          <div class="ct-done" data-done hidden tabindex="-1">
            <span class="ct-done__badge" aria-hidden="true"><svg viewBox="0 0 52 52"><circle cx="26" cy="26" r="24" /><path d="m15 27 7 7 15-16" /></svg></span>
            <h2 class="display">Message sent<span class="tone">.</span></h2>
            <p data-done-text>Thanks! Your message is in our inbox and we’ll reply soon.</p>
            <div class="ct-done__actions">
              <a class="btn btn--light btn--lg" href="/work/">Explore our work</a>
              <button class="btn btn--outline btn--lg" type="button" data-again>Send another</button>
            </div>
          </div>
        </div>

        <!-- Details -->
        <aside class="ct-side">
          <div class="ct-card ct-mail" data-fade>
            <p class="tag tag--dark"><i class="tag__dots"></i>Email us</p>
            <a class="ct-mail__addr display" href={`mailto:${email}`}>{email}</a>
            <button class="ct-copy" type="button" data-copy={email}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" /></svg>
              <span data-copy-label>Copy address</span>
            </button>
          </div>

          <div class="ct-card ct-loc" data-fade>
            <div>
              <p class="tag tag--dark"><i class="tag__dots"></i>Studio</p>
              <p class="ct-loc__city display">Lahore, Pakistan</p>
              <p class="ct-live mono"><i></i>Available worldwide</p>
            </div>
            <div class="ct-clock" aria-label="Local time in Lahore">
              <b class="display" data-clock>--:--</b>
              <small class="mono" data-clock-zone>Local time · PKT</small>
            </div>
          </div>

          <div class="ct-card ct-next" data-fade>
            <p class="tag tag--dark"><i class="tag__dots"></i>What happens next</p>
            <ol>
              {steps.map((s, i) => (
                <li><span class="mono">0{i + 1}</span><div><b>{s.t}</b><p>{s.d}</p></div></li>
              ))}
            </ol>
          </div>

          <a class="ct-card ct-behance" href="https://www.behance.net/Mohammad-Mohsin" target="_blank" rel="noopener" data-fade>
            <span><b>See more on Behance</b><small>Case studies, UI and social work</small></span>
            <svg class="arr" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
          </a>
        </aside>
      </div>
    </div>
  </section>
  <script>
    import '../scripts/sub.js';
    import '../scripts/contact.js';
  </script>
</Base>
