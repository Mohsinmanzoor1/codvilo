---
import Base from '../layouts/Base.astro';
import '../styles/contact.css';
import '../styles/services.css';
import { graph, breadcrumbs, SITE } from '../data/seo.js';

const title = 'Free Shopify & Ecommerce Store Audit | Codvilo';
const description = 'Get a free, personal review of your Shopify or WooCommerce store: design, speed, product pages and checkout, with quick wins to get more sales.';
const platforms = ['Shopify', 'WooCommerce', 'Other / not sure'];
const problems = ['Not enough sales', 'Slow store', 'Looks outdated', 'Checkout drop-offs', 'Poor mobile experience', 'Low traffic'];
const checks = [
  { t: 'First impression', d: 'Does your homepage make it clear what you sell and why to buy from you?' },
  { t: 'Product pages', d: 'Photos, copy, prices and trust signals that help people decide.' },
  { t: 'Mobile experience', d: 'How your store feels on a phone, where most of your customers shop.' },
  { t: 'Checkout path', d: 'Friction between “add to cart” and “order placed”.' },
  { t: 'Speed', d: 'Load time and the apps or images slowing it down.' },
  { t: 'Search basics', d: 'Titles, descriptions and structure that help Google find you.' },
];
const check = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>';
const ARR = '<svg class="arr" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>';
const jsonld = graph(
  { '@type': 'WebPage', url: `${SITE}/free-store-audit/`, name: title, description, isPartOf: { '@id': `${SITE}/#website` },
    mainEntity: { '@type': 'Service', name: 'Free ecommerce store audit', provider: { '@id': `${SITE}/#organization` }, areaServed: { '@type': 'Place', name: 'Worldwide' }, offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' } } },
  breadcrumbs([['Home', '/'], ['Free store audit', '/free-store-audit/']]),
);
---
<Base title={title} description={description} path="/free-store-audit/" jsonld={jsonld}>
  <section class="ct dark" data-theme="dark">
    <div class="ct__glow" aria-hidden="true"></div>
    <div class="wrap">
      <header class="ct__head">
        <p class="tag tag--dark" data-fade><i class="tag__dots"></i>Free store audit</p>
        <h1 class="display ct__title" data-split>Find out what’s <span class="tone">costing you sales.</span></h1>
        <p class="ct__lede" data-fade>Send us your Shopify or WooCommerce store. Mohsin will review it personally and email you the quick wins that would make the biggest difference, free, with no obligation.</p>
      </header>

      <div class="ct__grid">
        <div class="ct-card ct-form-card" data-fade>
          <form class="ct-form" data-audit-form novalidate>
            <label class="fld">
              <input name="storeUrl" type="text" inputmode="url" autocomplete="url" placeholder=" " required maxlength="200" />
              <span>Your store URL *</span>
              <em class="fld__err" data-err="storeUrl"></em>
            </label>
            <div class="ct-row">
              <label class="fld">
                <input name="name" type="text" autocomplete="name" placeholder=" " required maxlength="100" />
                <span>Your name *</span>
                <em class="fld__err" data-err="name"></em>
              </label>
              <label class="fld">
                <input name="email" type="email" autocomplete="email" placeholder=" " required maxlength="160" />
                <span>Email address *</span>
                <em class="fld__err" data-err="email"></em>
              </label>
            </div>
            <fieldset class="ct-set">
              <legend>Platform</legend>
              <div class="chips" data-chips="platform" data-single>
                {platforms.map((s, i) => <button type="button" class="chip" data-value={s} aria-pressed={i === 0 ? 'true' : 'false'}><i set:html={check} />{s}</button>)}
              </div>
            </fieldset>
            <fieldset class="ct-set">
              <legend>What’s the biggest problem? <small>Pick all that apply</small></legend>
              <div class="chips" data-chips="problems">
                {problems.map((s) => <button type="button" class="chip" data-value={s} aria-pressed="false"><i set:html={check} />{s}</button>)}
              </div>
            </fieldset>
            <label class="fld fld--area">
              <textarea name="message" rows="3" placeholder=" " maxlength="3000"></textarea>
              <span>Anything else we should know?</span>
            </label>
            <label class="hp" aria-hidden="true">Website <input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
            <div class="ct-submit">
              <button class="btn btn--primary btn--lg ct-send" type="submit" data-send>
                <span class="ct-send__label">Get my free audit</span>
                <span class="ct-send__spin" aria-hidden="true"></span>
                <Fragment set:html={ARR} />
              </button>
              <p class="ct-note">No spam, no obligation. We only use your email to send the audit.</p>
            </div>
            <p class="ct-alert" role="alert" data-alert hidden></p>
          </form>
          <div class="ct-done" data-done hidden tabindex="-1">
            <span class="ct-done__badge" aria-hidden="true"><svg viewBox="0 0 52 52"><circle cx="26" cy="26" r="24" /><path d="m15 27 7 7 15-16" /></svg></span>
            <h2 class="display">Audit requested<span class="tone">.</span></h2>
            <p data-done-text>Thanks! We’ll review your store and email you what we find.</p>
            <div class="ct-done__actions">
              <a class="btn btn--primary btn--lg" href="/services/shopify-development/">See our Shopify service <Fragment set:html={ARR} /></a>
              <a class="btn btn--secondary btn--lg" href="/work/">Explore our work</a>
            </div>
          </div>
        </div>

        <aside class="ct-side">
          <div class="ct-card ct-next" data-fade>
            <p class="tag tag--dark"><i class="tag__dots"></i>What we check</p>
            <ol>
              {checks.map((c, i) => <li><span class="mono">0{i + 1}</span><div><b>{c.t}</b><p>{c.d}</p></div></li>)}
            </ol>
          </div>
          <div class="ct-card ct-next" data-fade>
            <p class="tag tag--dark"><i class="tag__dots"></i>What you get</p>
            <ul class="svc-for audit-get">
              <li><i set:html={check} />A personal review by Mohsin, not an automated report</li>
              <li><i set:html={check} />The quick wins that would help most, in plain language</li>
              <li><i set:html={check} />Free, whether or not you work with us</li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>
  <script>
    import '../scripts/sub.js';
    import '../scripts/audit.js';
  </script>
</Base>
