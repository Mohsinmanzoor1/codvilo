---
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found — Codvilo</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main class="wrap" style="min-height:100svh;display:flex;flex-direction:column;justify-content:center;gap:24px">
      <p class="tag tag--dark"><i class="tag__dots"></i>Error 404</p>
      <h1 class="display h2">This page<br />got lost<span style="color:var(--accent)">.</span></h1>
      <p><a class="btn btn--primary btn--lg" href="/">Back to home <svg class="arr" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg></a></p>
    </main>
  </body>
</html>
