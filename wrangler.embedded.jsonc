{
  // Fallback deploy: the whole site bundled into the Worker script (see scripts/gen-worker.mjs).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codvilo",
  "main": ".worker/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  // Contact form: sends through Email Routing to the verified studio inbox.
  "send_email": [{ "name": "CONTACT", "destination_address": "hello.codvilo@gmail.com" }],
  "observability": { "enabled": true }
}
